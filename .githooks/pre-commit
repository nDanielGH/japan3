#!/usr/bin/env python
"""Run repository validation and Markdown checks before each commit."""

import os
import site
import shutil
import subprocess
import sys
import sysconfig
import tempfile
from pathlib import Path


repo_root = Path(
    subprocess.check_output(
        ["git", "rev-parse", "--show-toplevel"],
        text=True,
    ).strip()
)


def staged_markdown_files() -> list[str]:
    return [
        path
        for path in subprocess.check_output(
            [
                "git",
                "diff",
                "--cached",
                "--name-only",
                "--diff-filter=ACMR",
                "-z",
                "--",
                "*.md",
            ],
            cwd=repo_root,
        )
        .decode()
        .split("\0")
        if path
    ]


with tempfile.TemporaryDirectory(prefix="japan-trip-index-") as directory:
    snapshot = Path(directory)
    subprocess.check_call(
        ["git", "checkout-index", "--all", f"--prefix={snapshot}{os.sep}"],
        cwd=repo_root,
    )
    validator = repo_root / "scripts" / "validate.py"
    result = subprocess.call(
        [sys.executable, str(validator), "--root", str(snapshot)],
        cwd=snapshot,
    )
    if result:
        raise SystemExit(result)

    markdown_files = [
        str(snapshot / path)
        for path in staged_markdown_files()
        if (snapshot / path).is_file()
    ]

    if not markdown_files:
        raise SystemExit(0)

    rumdl = shutil.which("rumdl")
    if rumdl is None:
        script_dirs = [
            Path(sysconfig.get_path("scripts")),
            (
                Path(site.getuserbase())
                / f"Python{sys.version_info.major}{sys.version_info.minor}"
                / "Scripts"
            ),
        ]
        candidates = [
            scripts_dir / executable
            for scripts_dir in script_dirs
            for executable in ("rumdl", "rumdl.exe")
        ]
        rumdl = next((str(path) for path in candidates if path.is_file()), None)

    if rumdl is None:
        print(
            "rumdl is required for Markdown checks; install it with "
            "`python -m pip install --user rumdl`.",
            file=sys.stderr,
        )
        raise SystemExit(1)

    raise SystemExit(subprocess.call([rumdl, "check", *markdown_files], cwd=snapshot))
