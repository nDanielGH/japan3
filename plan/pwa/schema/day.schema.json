{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "day.schema.json",
  "title": "Japan day itinerary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "date",
    "timeZone",
    "utcOffset",
    "eyebrow",
    "title",
    "subtitle",
    "completion",
    "previewTimes",
    "preparation",
    "steps",
    "resources",
    "footer"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/date" },
    "date": { "$ref": "#/$defs/date" },
    "timeZone": { "type": "string", "minLength": 1 },
    "utcOffset": {
      "type": "string",
      "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
    },
    "eyebrow": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "footer": { "type": "string" },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "time", "summary"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "previewTimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "label"],
        "properties": {
          "time": { "$ref": "#/$defs/time" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "preparation": {
      "type": "array",
      "items": { "$ref": "#/$defs/preparationItem" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "preparationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "link": { "$ref": "#/$defs/link" }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "enum": ["paragraph", "warning"] },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "list" },
            "ordered": { "type": "boolean" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "label", "url"],
          "properties": {
            "type": { "const": "link" },
            "label": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" },
            "primary": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "label", "imageLabel", "src"],
          "properties": {
            "type": { "const": "image" },
            "label": { "type": "string", "minLength": 1 },
            "imageLabel": { "type": "string", "minLength": 1 },
            "src": { "type": "string", "minLength": 1 },
            "primary": { "type": "boolean" }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "end",
        "title",
        "kind",
        "summary",
        "hardDeadline",
        "blocks",
        "actions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["transit", "walk", "meal", "visit", "task", "break"]
        },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "hardDeadline": { "type": "boolean" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "resource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "label", "description", "url"],
          "properties": {
            "type": { "const": "link" },
            "label": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "label", "description", "imageLabel", "src"],
          "properties": {
            "type": { "const": "image" },
            "label": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "imageLabel": { "type": "string", "minLength": 1 },
            "src": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
